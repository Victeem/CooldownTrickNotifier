{
	"schemaVersion": 1,
	"id": "ctn",
	"version": "${version}",
	"name": "Cooldown Trick Notifier",
	"description": "PvP mod that plays a sound when you successfully cooldown trick.",
	"authors": [
		"Victeem"
	],
	"contact": {
		"sources": "https://github.com/Victeem/CooldownTrickNotifier"
	},
	"license": "MIT",
	"icon": "assets/ctn/icon.png",
	"environment": "*",
	"entrypoints": {
		"client": [
			"gay.plat.ctn.CooldownTrickNotifier"
		],
		"ukulib": [
			"gay.plat.ctn.UkulibHook"
		]
	},
	"mixins": [
		{
			"config": "ctn.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.1",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"ukulib": "^1.4.1"
	},
	"suggests": {
		"another-mod": "*"
	}
}